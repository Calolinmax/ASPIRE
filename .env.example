# ASPIRE agentic coding 的 LLM 配置（复制为 .env 并填入你的 key；.env 已 gitignore）
# provider: openai（OpenAI 兼容端点，含 vLLM/OpenRouter/Kimi/DeepSeek 等中转）| anthropic | file | mock
ASPIRE_LLM_PROVIDER=openai
ASPIRE_LLM_BASE_URL=https://api.openai.com/v1/chat/completions
ASPIRE_LLM_API_KEY=sk-...
ASPIRE_LLM_MODEL=gpt-5.4
# 可选：
# ASPIRE_LLM_TEMPERATURE=0.2
# ASPIRE_LLM_MAX_TOKENS=8192
# ASPIRE_LLM_TIMEOUT=200
# ASPIRE_DIGEST_MAX_IMAGES=8    # trace 摘要附图数；模型不支持视觉输入时设 0
#
# Kimi（Moonshot 平台 key，platform.moonshot.cn 控制台创建）示例：
# ASPIRE_LLM_PROVIDER=openai
# ASPIRE_LLM_BASE_URL=https://api.moonshot.cn/v1/chat/completions
# ASPIRE_LLM_API_KEY=sk-你的kimi平台key
# ASPIRE_LLM_MODEL=kimi-k2-0905-preview
#
# anthropic 示例：
# ASPIRE_LLM_PROVIDER=anthropic
# ASPIRE_LLM_BASE_URL=https://api.anthropic.com/v1/messages
# ASPIRE_LLM_MODEL=claude-opus-4-6
#
# Kimi K3 coding 订阅（Claude Code 同款 token，已实测 2026-08-10：/v1/messages + 视觉输入均可用）：
# ASPIRE_LLM_PROVIDER=anthropic
# ASPIRE_LLM_BASE_URL=https://api.kimi.com/coding/v1/messages
# ASPIRE_LLM_API_KEY=<你的 coding token>
# ASPIRE_LLM_MODEL=kimi-k3
# ASPIRE_LLM_MAX_TOKENS=16384
# file 桥接（无 key，人工/Claude Code 当模型，prompt/response 文件交换）：
# ASPIRE_LLM_PROVIDER=file
# ASPIRE_LLM_FILE_DIR=agent_runs/llm_bridge
